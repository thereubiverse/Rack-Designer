# deploy/.env.example — every variable the compose stack reads, with empty placeholders.
#
# This file is committed; deploy/.env is not (see .gitignore). scripts/install.sh generates
# deploy/.env for a real deployment — do not hand-write secrets into a copy of this file and commit
# it.

# Public hostname where this stack is reached, e.g. docs.example.com. Caddy requests and renews a
# TLS certificate for exactly this name — DNS must already point at the server before the first
# `docker compose up`, or certificate issuance fails.
APP_HOSTNAME=

# Password for the Postgres superuser and the internal service roles the images create
# (supabase_auth_admin, supabase_storage_admin, authenticator). Generated by scripts/install.sh.
POSTGRES_PASSWORD=

# Database name inside the Postgres container. Leave empty to use the image's default ("postgres").
POSTGRES_DB=

# Signing secret for every auth/rest/storage JWT. This is the single most valuable secret on the
# server — anyone holding it can mint a service_role token and read every client's documentation.
# Generated by scripts/install.sh; never hand-write it, never commit a real value.
JWT_SECRET=

# JWTs signed with JWT_SECRET carrying role: anon and role: service_role respectively. Generated by
# scripts/install.sh alongside JWT_SECRET — hand-writing them is where self-hosting usually goes
# wrong.
ANON_KEY=
SERVICE_ROLE_KEY=

# How long an issued JWT stays valid, in seconds. Leave empty for the default of 3600 (one hour).
JWT_EXPIRY=

# Device Wizard's Gemini free-tier vision calls (Google AI Studio). Server-side only.
GEMINI_API_KEY=

# Transactional email — member invites, password recovery, one-time device-approval codes. Leave
# all five empty to run without outgoing mail: sendEmail() then only logs to the console in
# development and silently refuses in production.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OAuth sign-in. Create these in Google Cloud Console / an Azure app registration. Leave unset to
# run with password sign-in only — the Google and Microsoft buttons then say they are not
# configured.
# Set to true ONLY once the client id and secret below are filled in. GoTrue exits fatally at
# startup if a provider is enabled but incompletely configured.
SUPABASE_AUTH_GOOGLE_ENABLED=
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_AZURE_ENABLED=
SUPABASE_AUTH_AZURE_CLIENT_ID=
SUPABASE_AUTH_AZURE_SECRET=

# Twilio, for confirming a member's phone number by text. Leave unset to run without SMS — the
# Verify button then says text confirmation isn't set up.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
