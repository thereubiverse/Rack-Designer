# OAuth providers. Create these in Google Cloud Console and Azure app registrations, then put the
# real values in .env.local, which is gitignored. Leave them unset to run with password sign-in only
# — the Google and Microsoft buttons will say they are not configured.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_AZURE_CLIENT_ID=
SUPABASE_AUTH_AZURE_SECRET=

# Twilio, for confirming a member's phone number by text. Create these in the Twilio console and put
# the real values in .env.local, which is gitignored. Leave them unset to run without SMS — the
# Verify button then says text confirmation isn't set up, and nothing else changes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Transactional email (member invites, password recovery). Create an API key in Resend, verify the
# domain you send from, and put the key here in .env.local, which is gitignored. Only needed once
# the SMTP block in supabase/config.toml is uncommented — until then mail goes to Mailpit at
# http://127.0.0.1:54324 and nothing leaves the machine.
RESEND_SMTP_PASSWORD=

# Where the deployed app lives. Used to build the OAuth redirect back to /auth/callback, and it must
# match site_url in supabase/config.toml. Unset falls back to http://localhost:3100.
NEXT_PUBLIC_SITE_URL=
