# The build installs its own dependencies on Linux — copying the dev machine's would bring
# @napi-rs/canvas's darwin-arm64 binary into a Linux image and break PDF rasterisation at runtime.
node_modules
.next
out

# Never let a real secret into a build context.
.env
.env.local
.env.*.local

.git
.github
.superpowers
.claude

# deploy/backups/ holds real client floor plans and avatars; deploy/.env holds the real JWT_SECRET
# and anon/service-role keys; deploy/caddy_data/ holds the live TLS state. `COPY . .` in the
# Dockerfile would otherwise drag all three into the build context and a builder layer.
deploy/backups/
deploy/.env
deploy/caddy_data/
coverage
playwright-report
test-results
e2e
docs
supabase/.temp
*.log
.DS_Store
