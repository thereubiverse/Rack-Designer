# The build installs its own dependencies on Linux — copying the dev machine's would bring
# @napi-rs/canvas's darwin-arm64 binary into a Linux image and break PDF rasterisation at runtime.
node_modules
.next
out

# Never let a real secret into a build context.
.env
.env.local
.env.*.local

.git
.github
.superpowers
.claude

# deploy/backups/ holds real client floor plans and avatars; deploy/.env holds the real JWT_SECRET
# and anon/service-role keys; deploy/caddy_data/ and deploy/caddy_config/ hold the live TLS state
# including the account private key; deploy/first-device-token.txt holds a RAW break-glass device
# token that signs its holder in as the admin with no emailed code. `COPY . .` in the Dockerfile
# would otherwise drag all of them into the build context and a builder layer — and install.sh runs
# `up -d --build` on every re-run, so a re-run after step 6 would bake the live token into the
# server's image cache.
deploy/backups/
deploy/.env
deploy/caddy_data/
deploy/caddy_config/
deploy/first-device-token.txt
coverage
playwright-report
test-results
e2e
docs
supabase/.temp
*.log
.DS_Store
